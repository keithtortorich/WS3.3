# =============================================================================
# Social Media Marketing Machine — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# --- PostgreSQL (primary datastore) ---
POSTGRES_USER=smm_admin
POSTGRES_PASSWORD=smm_dev_password
POSTGRES_DB=smm_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy DSN used by the FastAPI app (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://smm_admin:smm_dev_password@postgres:5432/smm_platform
# Sync DSN used by Alembic migrations (psycopg driver)
DATABASE_URL_SYNC=postgresql+psycopg://smm_admin:smm_dev_password@postgres:5432/smm_platform

# --- Redis (Celery broker/backend + caching) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- S3-Compatible Object Storage (works with AWS S3 or local MinIO) ---
S3_ENDPOINT_URL=http://minio:9000     # leave unset/blank to use real AWS S3
S3_ACCESS_KEY_ID=smm_minio_admin
S3_SECRET_ACCESS_KEY=smm_minio_password
S3_BUCKET_NAME=smm-media
S3_REGION=us-east-1
S3_USE_SSL=false
S3_PUBLIC_URL_BASE=http://localhost:9000/smm-media

# --- Clerk Auth (multi-tenant JWT auth) ---
# Get these from https://dashboard.clerk.com -> your application -> API Keys
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUDIENCE=
# Frontend-only (Next.js reads NEXT_PUBLIC_* at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# --- AI Provider Selection ---
# Which provider the AIProviderFactory instantiates by default.
# Only "ollama" is fully implemented in this scaffold; the rest are typed stubs.
AI_PROVIDER=ollama                    # ollama | openai | claude | gemini | grok | hermes

# Ollama (local, no API key required)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# Stub providers — keys documented for when real implementations are added
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
HERMES_API_KEY=

# --- Social Platform: LinkedIn (fully implemented) ---
LINKEDIN_CLIENT_ID=replace_me
LINKEDIN_CLIENT_SECRET=replace_me
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
LINKEDIN_API_VERSION=202405

# --- Social Platforms: stubs (documented for future implementation) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
X_API_KEY=
X_API_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=

# --- Celery / Worker tuning ---
CELERY_TASK_ALWAYS_EAGER=false
CELERY_WORKER_CONCURRENCY=4
PUBLISH_RETRY_MAX_ATTEMPTS=5
PUBLISH_RETRY_BACKOFF_BASE_SECONDS=30

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Testing ---
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# --- Frontend-only: backend API base URL the Next.js app calls ---
# (NEXT_PUBLIC_* vars are inlined at build time; keep in sync with APP_BASE_URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
