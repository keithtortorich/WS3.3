# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
pytest-cache-files-*/

# SQLite runtime data (never commit generated/local databases)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Local secrets
.env
.env.*
!.env.example
.vercel

# Logs
*.log

# macOS
.DS_Store

# Editor/IDE
.vscode-test
.env*

# WebStaffr 3.0 and social-media-marketing-machine were merged into this
# repo's history on 2026-07-25 (see commits e92d94d, 012bb82; full pre-merge
# history at branches archive/webstaffr-3.0-pre-merge and archive/smm-pre-merge).
# They are genuinely tracked subdirectories now, not sibling repos — do not
# re-add an ignore entry for these paths.

# Nested venvs (each subproject keeps its own; the global .venv/ pattern
# above already covers these, listed for clarity)
/WebStaffr 3.0/.venv/
/social-media-marketing-machine/backend/.venv/
/social-media-marketing-machine/frontend/node_modules/
